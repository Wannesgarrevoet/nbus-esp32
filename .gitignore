# Arduino / arduino-cli build output
/build/
/firmware/build/
*.bin
*.elf
*.hex
*.map

# Local secrets (WiFiManager stores credentials on-device; nothing should be committed)
secrets.h
*.local

# Bus captures. Registers 0x54/0x55 carry the devices' real serial numbers, so a capture
# identifies specific hardware. Keep them beside the repo, never inside it.
/captures/
ring-*.txt
*.capture

# Python helper scripts in tools/
__pycache__/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
